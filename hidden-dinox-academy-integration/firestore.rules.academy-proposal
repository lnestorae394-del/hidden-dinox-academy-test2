// HIDDEN DINOX ACADEMY — ПРЕДЛОЖЕНИЕ правил Firestore (не применено и не проверено на эмуляторе).
//
// Сервер работает через Admin SDK, который правила НЕ проверяют. Клиент академии с Firestore
// напрямую не работает: всё идёт через /api. Поэтому для коллекций академии клиенту нужен полный запрет.
//
// ВАЖНО перед применением:
// 1) Правила Firestore складываются по «ИЛИ»: если в текущих правилах есть широкое разрешение
//    (например, match /{document=**} { allow read, write: if true; }), блоки ниже ничего не запретят.
//    Такое правило нужно убрать или сузить.
// 2) Старые страницы AI BOOST могли читать или писать referrals/users прямо из браузера.
//    Запрет может их сломать — сначала нужно увидеть текущие правила и старые страницы.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Коллекции академии: только сервер ---
    match /users/{uid}               { allow read, write: if false; }
    match /clicks/{clickId}          { allow read, write: if false; }
    match /trader_bindings/{traderId} { allow read, write: if false; }
    match /postback_events/{eventId} { allow read, write: if false; }
    match /deposit_events/{eventId}  { allow read, write: if false; }

    // --- Старая коллекция партнёрских данных: только сервер ---
    // (если старые страницы читают её из браузера — согласовать отдельно)
    match /referrals/{traderId}      { allow read, write: if false; }

    // --- Остальные существующие правила проекта — перенести сюда без изменений ---
  }
}
